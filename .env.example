# Copy to .env and replace every secret. Never commit .env.

# SQLAlchemy URL. Use host "db" inside Docker Compose, "localhost" when running locally.
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/diagnostic_booking

# Used by docker-compose to initialise the PostgreSQL container.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=diagnostic_booking

# JWT signing. At least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Shared secret for HMAC-SHA256 webhook signatures (at least 32 characters).
WEBHOOK_SECRET=change-me-to-another-long-random-string-32-chars

# Simulated payment provider: success | failure | random | pending
PAYMENT_SIMULATION_MODE=success
# Probability of success when PAYMENT_SIMULATION_MODE=random
PAYMENT_SUCCESS_RATE=0.8

# Booking lifecycle
# Minutes an unpaid PENDING booking holds its slot before it expires (0 = never expire).
BOOKING_HOLD_MINUTES=30
# Minutes after which a still-PENDING payment is reconciled and, if unresolved, marked FAILED.
PAYMENT_PENDING_TIMEOUT_MINUTES=15
# Patients can cancel/reschedule a CONFIRMED booking up to this many hours before it.
CANCELLATION_WINDOW_HOURS=24

LOG_LEVEL=INFO
